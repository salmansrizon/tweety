# Supabase (config DB + pgvector store)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_KEY=   # service role key -- server-only (ETL + Next.js API routes), never exposed to the client

# Google Gemini (text-embedding-004) -- ETL embeddings and the RAG API route's query embedding
GEMINI_API_KEY=

# OpenRouter (web RAG API only -- free model router)
OPENROUTER_API_KEY=

# Google Cloud (ETL only -- BigQuery service account key, JSON)
GCP_SA_KEY=

# Reddit API (ETL only -- PRAW script app credentials)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
